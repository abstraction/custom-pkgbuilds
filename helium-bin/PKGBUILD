pkgname=helium-bin
pkgver=0.18.1.1
pkgrel=1
pkgdesc="A lightweight chromium derivative"
arch=('x86_64' 'aarch64')
url="https://github.com/imputnet/helium-linux"
license=('BSD-3-Clause')
options=('!strip')
source_x86_64=("https://github.com/imputnet/helium-linux/releases/download/${pkgver}/helium-${pkgver}-x86_64_linux.tar.xz")
source_aarch64=("https://github.com/imputnet/helium-linux/releases/download/${pkgver}/helium-${pkgver}-arm64_linux.tar.xz")
sha256sums_x86_64=('9f4d35239eea18b290846221874265ac2a8637adff954df69fdef77d6b15042c')
sha256sums_aarch64=('509ea4bfc617fff456f4584814894c6da71b3fe5b6d09637b08b4f3c76abec9e')

package() {
    # Determine the arch string used in the source directory name
    local srcarch="${CARCH}"
    if [ "$srcarch" = "aarch64" ]; then
        srcarch="arm64"
    fi
    
    install -d "$pkgdir/opt/helium"
    cp -r "$srcdir/helium-${pkgver}-${srcarch}_linux/"* "$pkgdir/opt/helium/"
    
    install -d "$pkgdir/usr/bin"
    ln -s /opt/helium/helium-wrapper "$pkgdir/usr/bin/helium"
    
    # Install desktop file and icon
    install -D -m644 "$pkgdir/opt/helium/helium.desktop" "$pkgdir/usr/share/applications/helium.desktop"
    install -D -m644 "$pkgdir/opt/helium/product_logo_256.png" "$pkgdir/usr/share/pixmaps/helium.png"
}
